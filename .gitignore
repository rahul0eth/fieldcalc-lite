.DS_Store
node_modules/
npm-debug.log*
.env
.env.*
.vscode/
.idea/

# Capacitor: the native projects ARE committed (you edit signing, Info.plist,
# icons in them). Only their build output is ignored -- `npx cap add` writes
# .gitignore files inside ios/ and android/ that handle that.
/ios/App/Pods/
/ios/App/App/public/
/android/app/src/main/assets/public/
icons/

# Android release signing — never commit these
android/key.properties
*.jks
*.keystore
